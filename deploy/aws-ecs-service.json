{
  "serviceName": "finmind",
  "cluster": "finmind-cluster",
  "taskDefinition": "finmind",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "deploymentConfiguration": {
    "maximumPercent": 200,
    "minimumHealthyPercent": 100,
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    }
  },
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["SUBNET_IDS"],
      "securityGroups": ["SG_ID"],
      "assignPublicIp": "ENABLED"
    }
  },
  "loadBalancers": [
    {
      "targetGroupArn": "BACKEND_TG_ARN",
      "containerName": "finmind-backend",
      "containerPort": 8000
    },
    {
      "targetGroupArn": "FRONTEND_TG_ARN",
      "containerName": "finmind-frontend",
      "containerPort": 80
    }
  ],
  "healthCheckGracePeriodSeconds": 120
}
